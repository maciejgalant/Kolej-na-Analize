# Skopiuj do .env i dostosuj. Pliku .env NIE commitujemy.
COMPOSE_PROJECT_NAME=railsafe

# --- PostGIS ---
POSTGRES_DB=railsafe
POSTGRES_USER=railsafe
POSTGRES_PASSWORD=zmien_mnie_lokalnie
# Port na hoście (tylko 127.0.0.1). Zmień, jeśli koliduje np. z GeoGraph.
POSTGIS_HOST_PORT=55432

# --- Porty hosta (tylko 127.0.0.1) ---
BACKEND_HOST_PORT=8765
FRONTEND_HOST_PORT=8080

# --- Ollama / Qwen ---
# Tag modelu do potwierdzenia w RSA-013 (wymagana obsługa wywołań funkcji).
OLLAMA_MODEL=qwen3:4b-instruct

# Karta graficzna NVIDIA dla modelu (opcjonalnie; opis w docker-compose.gpu.yml).
# Windows:
# COMPOSE_FILE=docker-compose.yml;docker-compose.gpu.yml
# Linux/macOS:
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml

# --- Tryb demonstracyjny ---
# Flaga trybu demonstracyjnego; rzeczywisty zestaw danych rozpoznawany jest z bazy.
DEMO_MODE=true

# --- Klucze dostawców (opcjonalne, puste = adapter wyłączony) ---
# PKP PLK: klucz tylko w backendzie, instrukcja docs/PKP_API.md.
PLK_API_KEY=
TRAFFIC_API_KEY=
